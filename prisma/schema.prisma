generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Abonnement {
  id                String       @id @default(cuid())
  nom               String
  prixMensuel       Float
  ticketsRH         Int          @default(0)
  prixTicketSupp    Float        @default(0)
  salariesInclus    Int          @default(0)
  prixSalarieSupp   Float        @default(0)
  features          String[]
  createdAt         DateTime     @default(now())

  entreprises       Entreprise[]
}

model Entreprise {
  id                String             @id @default(cuid())
  nom               String
  siret             String?
  telephone         String?
  email             String?
  siteWeb           String?

  rue               String?
  codePostal        String?
  ville             String?
  pays              String?

  iban              String?
  bic               String?
  banque            String?

  // Prélèvement SEPA des abonnements (Stripe) : l'IBAN reste chez Stripe, seuls ses 4 derniers chiffres sont gardés
  stripeClientId    String?            @unique

  // Suivi commercial : remise permanente (%), appliquée aux abonnements et options sur chaque facture ;
  // code de parrainage de l'entreprise (à partager) et entreprise marraine ; début du contrat
  remisePct         Float?
  codeParrainage    String?            @unique
  parrainId         String?
  // Bilan mensuel envoyé au dirigeant le 1er du mois
  bilanMensuel      Boolean            @default(true)
  dateDebutContrat  DateTime?
  remises           Remise[]
  // Commission à reverser (apporteur d'affaires, parrain…) : % du CA de ce client, à partir d'un mois, pendant N mois (vide = sans fin)
  commissionPct          Float?
  commissionBeneficiaire String?
  commissionParrainId    String?
  commissionMoisDebut    Int?
  commissionAnneeDebut   Int?
  commissionNbMois       Int?
  commissionSource       String?   // PARRAINAGE | CODE_PROMO | MANUELLE
  commissionsVersees     CommissionVersee[]

  // Cabinet comptable qui suit ce client (accès cabinet)
  cabinetId         String?
  cabinet           Cabinet?           @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  mandatStatut      String?            // ACTIF, EN_ATTENTE, INACTIF (null : pas encore signé)
  mandatIbanFin     String?
  mandatSigneAt     DateTime?

  abonnementId      String?
  demo              Boolean            @default(false)
  tauxCharges       Float              @default(40) // % de charges patronales (estimation)
  actif             Boolean            @default(true)
  motifSuspension   String?
  dateSuspension    DateTime?
  abonnement        Abonnement?        @relation(fields: [abonnementId], references: [id])
  ticketsUtilises   Int                @default(0)

  permissions       String[]           @default(["salaries", "paie", "tickets", "absences", "entreprise", "helpdesk"])
  // Indicateurs RH : budgets annuels (facultatifs)
  logoClient        LogoEntreprise?
  // Avantages versés chaque mois : tickets restaurant (valeur, part patronale), panier repas (montant/jour), autres (libellés)
  avantages         Json?
  budgetPrimesAnnuel    Float?
  budgetFormationAnnuel Float?
  // Convention collective et secteur d'activité (saisis par le client)
  ccn               String?
  secteur           String?

  createdAt         DateTime           @default(now())

  utilisateurs      Utilisateur[]
  salaries          Salarie[]
  demandesEvolution DemandeEvolution[]
  tickets           Ticket[]
  variablesPaie     VariablePaie[]
  absences          Absence[]
  ticketsSupport    TicketSupport[]
  facturations      Facturation[]
  recrutements      DemandeRecrutement[]
  abonnementPaieId  String?
  abonnementPaie    AbonnementPaie? @relation(fields: [abonnementPaieId], references: [id])
  bulletinsUtilises Int             @default(0)
  demandesEvolutionPaie DemandeEvolutionPaie[]
  demandesSalaries  DemandeSalarie[]
  prestations       CommandePrestation[]
  faqs              FAQ[]
  communications    Communication[]
  releves           ReleveMois[]
  devis             Devis[]
  questionsRH       QuestionRH[]
  formations        Formation[]
  etablissements    Etablissement[]
  services          Service[]
  notesFrais        NoteFrais[]
  questionsInternes QuestionInterne[]
  demandesServices  DemandeService[]
  journal           JournalPaie[]
  clotures          ClotureMois[]
  trames            TrameContrat[]
  contrats          DemandeContrat[]
  piecesJointes     PieceJointe[]
  modelesCourriers  ModeleCourrier[]
  accidents         AccidentTravail[]
  pointages         Pointage[]
  projets           Projet[]
  devisProjets      DevisProjet[]
  facturesProjets   FactureProjet[]
}

model Facturation {
  id              String      @id @default(cuid())
  // Relances automatiques d'impayé (après la date limite)
  relances        Int         @default(0)
  derniereRelance DateTime?
  mois            Int
  annee           Int
  montant         Float
  dateLimitePaie  DateTime?
  statut          String      @default("En attente")
  commentaire     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  entrepriseId    String
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, annee, mois])
  @@index([annee, mois])
}

model DemandeRecrutement {
  id                String     @id @default(cuid())
  statut            String     @default("Reçue")
  poste             String
  typeContrat       String
  dateDebut         DateTime?
  salaireMini       Float?
  salaireMaxi       Float?
  primes            String?
  missions          String
  profil            String
  experience        String?
  formation         String?
  commentaire       String?
  cgvAcceptees      Boolean    @default(false)
  // Grille : NON_QUALIFIE, TECHNICIEN ou EXPERT (lancement 400 € + primes à la signature et à la fin d'essai)
  categorie         String     @default("NON_QUALIFIE")
  // true : lancement et primes calculés dans la facture du mois (les anciennes demandes ont été facturées à part)
  facturationAuto   Boolean    @default(false)
  candidat          String?
  signatureAt       DateTime?
  finEssaiAt        DateTime?
  termineAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  entrepriseId      String
  entreprise        Entreprise @relation(fields: [entrepriseId], references: [id])
  @@index([entrepriseId]) // ajouté pour accélérer les recherches
}

model DemandeEvolution {
  id              String      @id @default(cuid())
  statut          String      @default("En attente")
  message         String?
  createdAt       DateTime    @default(now())

  entrepriseId    String
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  abonnementId    String
  @@index([entrepriseId]) // ajouté pour accélérer les recherches
}

model Utilisateur {
  id           String      @id @default(cuid())
  email        String      @unique
  motDePasse   String
  prenom       String
  role         Role        @default(CLIENT)
  createdAt    DateTime    @default(now())

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  // Présentation guidée vue (première connexion) ; vide = à montrer
  visiteVueLe  DateTime?

  // Espace salarié : compte relié à une fiche salarié
  salarieId    String?     @unique
  salarie      Salarie?    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  actif        Boolean     @default(true)
  lectures     LectureCommunication[]

  // Dirigeant d'établissement : accès limité à cet établissement (vide = dirigeant général, voit tout)
  etablissementId      String?
  etablissement        Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: Restrict)
  // Droits retirés à ce compte en plus de ceux de l'entreprise (ex. « salaries.salaires »)
  permissionsRetirees  String[]       @default([])

  // Compte CABINET (expert-comptable) : un accès pour plusieurs entreprises clientes
  cabinetId            String?
  cabinet              Cabinet?       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  cabinetGerant        Boolean        @default(false) // gère les collaborateurs du cabinet
  clientsCabinet       String[]       @default([])    // entreprises autorisées (vide = tous les clients du cabinet)
  profilCabinet        String?                        // profil de droits choisi (PROFILS_DROITS)

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId])
}

model TokenReset {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  // vide = visible par tous les clients ; sinon réservée à une seule entreprise
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  module    String
  question  String
  reponse   String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salarie {
  id                    String         @id @default(cuid())
  // RGPD : date d'anonymisation (identité, coordonnées, n° SS et IBAN effacés ; données de paie conservées pour les obligations légales)
  anonymiseLe           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  statut                String         @default("Actif")

  entrepriseId          String
  entreprise            Entreprise     @relation(fields: [entrepriseId], references: [id])

  nom                   String
  prenom                String
  email                 String?
  telephone             String?
  dateNaissance         DateTime?
  lieuNaissance         String?
  nationalite           String?
  numeroSecuriteSociale String?

  rue                   String?
  codePostal            String?
  ville                 String?
  pays                  String?

  poste                 String
  typeContrat           String?
  dateDebut             DateTime?
  dateFin               DateTime?
  heuresHebdomadaires   Float?
  manager               String?
  conventionCollective  String?
  categorie             String?
  coefficient           String?
  position              String?
  iban                  String?
  // Gestion RH : SALARIE | MANAGER | DIRIGEANT, et N+1 (fiche du manager)
  roleRH                String         @default("SALARIE")
  managerId             String?
  managerFiche          Salarie?       @relation("Hierarchie", fields: [managerId], references: [id], onDelete: SetNull)
  equipe                Salarie[]      @relation("Hierarchie")
  // Droits du manager, cochés dans sa fiche
  voitSalairesEquipe    Boolean        @default(false)
  saisieVariables       Boolean        @default(false)
  // Badge : salarié itinérant, pointage sans contrôle de zone
  badgeSansZone         Boolean        @default(false)
  pointages             Pointage[]
  notesFrais            NoteFrais[]
  // Projets (option) : coût horaire standard saisi à la main (sinon calculé depuis le salaire et le taux de charges)
  coutHoraireStandard   Float?
  affectations          AffectationProjet[]
  tempsProjets          TempsProjet[]
  projetsResponsable    Projet[]       @relation("ResponsableProjet")

  salaireMensuel        Float?
  salaireAnnuel         Float?
  primes                Float?
  avantages             String?
  // Avantages mensuels du salarié : bénéficie des TR / paniers, jours par mois, autres montants (transport…)
  avantagesMensuels     Json?

  titreSejour           DateTime?
  sexe                  String?  // F | M (registre unique du personnel)
  matricule             String?
  // Indicateurs RH
  etablissement         String?
  service               String?
  soldeConges           Float?
  // Congés (BTP) : solde de reprise saisi ou importé ; le calcul automatique part de ces chiffres à cette date
  congesRepriseDate     DateTime?
  congesRepriseReste    Float?   // jours restant à prendre à la date de reprise
  congesRepriseEnCours  Float?   // jours acquis sur la période en cours à la date de reprise
  motifSortie           String?  // renseigné à la déclaration de sortie (Paie › Déclarer une sortie)
  suiviMedical          String?  // SIG (général) | SIA (adapté) | SIR (renforcé) — option Suivi médical complet
  derniereVisite        DateTime? // date de la dernière visite auprès de la santé au travail
  accidents             AccidentTravail[]
  formations            Formation[]
  rappels               RappelSalarie[]
  compte                Utilisateur?
  bulletins             Bulletin[]
  checklists            ChecklistSalarie[]
  entretiens            Entretien[]

  documents             Document[]
  variablesPaie         VariablePaie[]
  absences              Absence[]
  releves               ReleveMois[]

  @@unique([entrepriseId, matricule])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model Document {
  id          String   @id @default(cuid())
  nom         String
  type        String
  url         String   @default("")
  dateAjout   DateTime @default(now())
  // Fichier déposé par le client (stocké dans la base), éventuellement lié à une échéance
  contenu     Bytes?
  // clé du fichier sur OVH Object Storage (si le stockage OVH est configuré)
  cle         String?
  mime        String?
  taille      Int?
  rappelId    String?
  auteur      String?

  salarieId   String
  salarie     Salarie  @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  @@index([salarieId]) // ajouté pour accélérer les recherches
}

model Ticket {
  id           String          @id @default(cuid())
  titre        String
  description  String
  statut       String          @default("Ouvert")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  entrepriseId String
  entreprise   Entreprise      @relation(fields: [entrepriseId], references: [id])

  messages     MessageTicket[]

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model MessageTicket {
  id        String   @id @default(cuid())
  contenu   String
  auteur    String
  role      Role
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // index ajouté pour accélérer les recherches
  @@index([ticketId])
}

model TicketSupport {
  id           String                @id @default(cuid())
  titre        String
  description  String
  categorie    CategorieSupport
  statut       String                @default("Ouvert")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  entrepriseId String
  entreprise   Entreprise            @relation(fields: [entrepriseId], references: [id])

  messages     MessageTicketSupport[]

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model MessageTicketSupport {
  id        String        @id @default(cuid())
  contenu   String
  auteur    String
  role      Role
  createdAt DateTime      @default(now())

  ticketId  String
  ticket    TicketSupport @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // index ajouté pour accélérer les recherches
  @@index([ticketId])
}

model VariablePaie {
  id             String       @id @default(cuid())
  type           TypeVariable
  valeur         Float
  commentaire    String?
  mois           Int
  annee          Int
  statut         String       @default("En attente")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dateValidation DateTime?
  dateReset      DateTime?

  salarieId      String
  salarie        Salarie      @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  entrepriseId   String
  entreprise     Entreprise   @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, annee, mois])
  @@index([annee, mois, statut])
  @@index([salarieId])
}

model Absence {
  id           String      @id @default(cuid())
  type         TypeAbsence
  dateDebut    DateTime
  dateFin      DateTime
  commentaire  String?
  statut       String      @default("En attente")
  declareeParSalarie Boolean @default(false) // saisie depuis l'espace salarié
  motifRefus   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  salarieId    String
  salarie      Salarie     @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  entrepriseId String
  entreprise   Entreprise  @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
  @@index([salarieId])
}

enum TypeVariable {
  HEURE_SUPPLEMENTAIRE
  PRIME
  NOTE_FRAIS
  ACOMPTE
}

enum TypeAbsence {
  CONGE_PAYE
  RTT
  CONGE_SANS_SOLDE
  CONGE_EXCEPTIONNEL
  CONGE_NAISSANCE
  MATERNITE_PATERNITE
  MALADIE
  ABSENCE_NON_REMUNEREE
}

enum CategorieSupport {
  BUG
  QUESTION
  SUGGESTION
  PROBLEME_TECHNIQUE
}

enum Role {
  ADMIN
  CLIENT
  SALARIE
  CABINET
}

model AbonnementPaie {
  id                    String     @id @default(cuid())
  code                  String     @unique // "ESSENTIELLE" | "SERENITE" | "PREMIUM"
  nom                   String
  couleur               String     @default("#6366f1")
  prixMensuel           Float
  bulletinsInclus       Int
  prixBulletinSupp      Float
  // Features booléennes
  relancesVariables     Boolean    @default(false)
  relancesSalaries      Boolean    @default(false)
  modificationsIncluses Boolean    @default(false)
  regularisationsInclus Boolean    @default(false)
  demandesComplexes     Boolean    @default(false)
  veillePaie            Boolean    @default(false)
  conseilPaie           Boolean    @default(false)
  suiviRH               Boolean    @default(false) // périodes essai, CDD, absences, maladie, visites médicales
  suiviIJSS             Boolean    @default(false)
  relancesIJSS          Boolean    @default(false)
  recouvrementIJSS      Boolean    @default(false)
  tableauBord           String     @default("none") // "none" | "simple" | "complet"
  pointPaie             Boolean    @default(false)
  recommandationsPaie   Boolean    @default(false)
  traitementPrioritaire Boolean    @default(false)
  assistanceURSSAF      Boolean    @default(false)
  accesWebApp           Boolean    @default(true)  // application Franeo (web + téléphone)
  entreesSortiesIncluses Boolean   @default(false) // arrivées et soldes de tout compte inclus
  prixEntree            Float      @default(45)    // si non inclus : prix d'une arrivée
  prixSortie            Float      @default(60)    // si non inclus : prix d'une sortie (STC)
  ticketsRHInclus       Int        @default(0)     // tickets RH offerts chaque mois avec la formule paie
  prixTicketSupp        Float      @default(0)     // prix d'un ticket RH au-delà des tickets inclus
  espaceSalarieInclus   Boolean    @default(false) // espace salarié inclus (Premium, Entreprise)
  prixEspaceSalarie     Float      @default(1)     // sinon : prix par salarié et par mois
  createdAt             DateTime   @default(now())
  entreprises           Entreprise[]
  demandesAncienne DemandeEvolutionPaie[] @relation("AncienneFormulePaie")
  demandesNouvelle DemandeEvolutionPaie[] @relation("NouvelleFormulePaie")
}

model DemandeEvolutionPaie {
  id            String    @id @default(cuid())
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id])
  ancienneFormuleId String?
  ancienneFormule   AbonnementPaie? @relation("AncienneFormulePaie", fields: [ancienneFormuleId], references: [id])
  nouvelleFormuleId String
  nouvelleFormule   AbonnementPaie  @relation("NouvelleFormulePaie", fields: [nouvelleFormuleId], references: [id])
  statut        String    @default("EN_ATTENTE")
  createdAt     DateTime  @default(now())
  traiteeAt     DateTime?
  @@index([entrepriseId]) // ajouté pour accélérer les recherches
}

model Actualite {
  id          String   @id @default(cuid())
  titre       String
  contenu     String
  thematique  String   @default("Général")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuddyContexte {
  userId    String   @id
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
  @@index([userId]) // ajouté pour accélérer les recherches
}

model RappelSalarie {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  type         String
  libelle      String?
  dateEcheance DateTime
  commentaire  String?
  traite       Boolean   @default(false)
  traiteAt     DateTime?

  salarieId    String
  salarie      Salarie   @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  @@index([dateEcheance])

  // index ajouté pour accélérer les recherches
  @@index([salarieId])
}
// Demande de validation d'un client « paie » : ajout, modification ou suppression d'un salarié
model DemandeSalarie {
  id           String     @id @default(cuid())
  type         String     // "AJOUT" | "MODIFICATION" | "SUPPRESSION"
  statut       String     @default("EN_ATTENTE") // "EN_ATTENTE" | "VALIDEE" | "REFUSEE"
  resume       String
  donnees      Json?
  motifRefus   String?
  auteur       String?
  createdAt    DateTime   @default(now())
  traiteAt     DateTime?

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  salarieId    String?

  @@index([entrepriseId, statut])
  @@index([statut])
  @@index([salarieId]) // ajouté pour accélérer les recherches
}

// Prestation commandée par un client depuis l'application (facturée sur le mois de la commande)
model CommandePrestation {
  id           String     @id @default(cuid())
  code         String     // ex. "RECTIFICATIF", "RUPTURE_CONV"
  libelle      String
  quantite     Int        @default(1)
  prixUnitaire Float      // 0 = inclus dans la formule
  total        Float
  statut       String     @default("A_FAIRE") // "A_FAIRE" | "FAITE" | "ANNULEE"
  commentaire  String?
  salarie      String?    // nom du salarié concerné (texte, pour garder la trace)
  auteur       String?
  mois         Int
  annee        Int
  createdAt    DateTime   @default(now())
  faiteAt      DateTime?

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId, annee, mois])
  @@index([statut])
}


// Communication publiée par l'admin : affichée sur le tableau de bord jusqu'à ce que la personne clique « J'ai lu »
model Communication {
  id           String      @id @default(cuid())
  titre        String
  contenu      String
  // CLIENTS, SALARIES ou TOUS
  cible        String      @default("CLIENTS")
  // vide = toutes les entreprises
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  importante   Boolean     @default(false)
  // INFO (communication classique) ou MISE_A_JOUR (résumé d'une mise à jour de l'application)
  type         String      @default("INFO")
  // Programmation : visible à partir de publieLe (vide = tout de suite), retirée après expireLe (vide = jamais)
  publieLe     DateTime?
  expireLe     DateTime?
  createdAt    DateTime    @default(now())
  lectures     LectureCommunication[]

  @@index([createdAt])
}

model LectureCommunication {
  id              String        @id @default(cuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  utilisateurId   String
  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luAt            DateTime      @default(now())

  @@unique([communicationId, utilisateurId])
  @@index([utilisateurId]) // ajouté pour accélérer les recherches
}

// Relevé d'activité mensuel du salarié : brouillon enregistré au fil du mois, puis envoyé (verrouillé)
// statut : Brouillon → Envoyé → Validé (ou Refusé, qui le rouvre au salarié)
model ReleveMois {
  id           String         @id @default(cuid())
  salarieId    String
  salarie      Salarie        @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  entreprise   Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  mois         Int
  annee        Int
  statut       String         @default("Brouillon")
  motifRefus   String?
  envoyeAt     DateTime?
  valideAt     DateTime?
  // variable de paie « heures supplémentaires » créée à la validation
  variableId   String?
  // commentaire du salarié sur son relevé
  commentaire  String?
  valideePar   String?
  // l'admin peut bloquer l'annulation d'un relevé validé (paie déjà faite)
  annulationBloquee Boolean   @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  jours        ReleveJour[]

  @@unique([salarieId, annee, mois])
  @@index([entrepriseId, statut])
}

model ReleveJour {
  id          String     @id @default(cuid())
  releveId    String
  releve      ReleveMois @relation(fields: [releveId], references: [id], onDelete: Cascade)
  // jour (stocké à midi UTC)
  date        DateTime
  heures      Float?
  heuresSupp  Float      @default(0)
  teletravail Boolean    @default(false)
  commentaire String?
  // Option Projets : répartition des heures du jour par projet [{ projetId, heures }] (heures vides = toute la journée)
  projets     Json?

  @@unique([releveId, date])
}

// Demande de devis faite par le client depuis le catalogue (Mon entreprise › Demande de devis)
// statut : EN_ATTENTE → ENVOYE (proposition de l'admin) → ACCEPTE / REFUSE, ou ANNULE
model Devis {
  id             String     @id @default(cuid())
  entrepriseId   String
  entreprise     Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  lignes         Json
  totalIndicatif Float      @default(0)
  message        String?
  auteur         String?
  statut         String     @default("EN_ATTENTE")
  montantPropose Float?
  reponse        String?
  reponduAt      DateTime?
  decideAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  messages       MessageDevis[]
  piecesJointes  PieceJointe[]
  // Devis validé : montant ajouté à la facture du mois choisi (ligne de prestation)
  commandeId     String?
  montantFacture Float?
  factureMois    Int?
  factureAnnee   Int?

  @@index([entrepriseId, statut])
}

// Échange écrit entre le client et FRANEO RH sur un devis
model MessageDevis {
  id        String   @id @default(cuid())
  devisId   String
  devis     Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  role      String   // ADMIN | CLIENT
  auteur    String
  contenu   String
  createdAt DateTime @default(now())

  @@index([devisId])
}

// Demande RH ponctuelle : question simple, échange rapide, non décomptée des tickets
// statut : OUVERTE → REPONDUE (ou TICKET si l'admin demande d'ouvrir un ticket) → CLOSE
model QuestionRH {
  id           String            @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise        @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  sujet        String
  statut       String            @default("OUVERTE")
  auteur       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     MessageQuestionRH[]
  piecesJointes PieceJointe[]

  @@index([entrepriseId, statut])
}

model MessageQuestionRH {
  id         String     @id @default(cuid())
  questionId String
  question   QuestionRH @relation(fields: [questionId], references: [id], onDelete: Cascade)
  role       String     // ADMIN | CLIENT
  auteur     String
  contenu    String
  // réponse rapide « merci d'ouvrir un ticket » : affiche le lien vers un nouveau ticket
  versTicket Boolean    @default(false)
  createdAt  DateTime   @default(now())
}

// Formation suivie par un salarié (indicateurs RH : heures et budget)
model Formation {
  id           String     @id @default(cuid())
  salarieId    String
  salarie      Salarie    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  intitule     String
  date         DateTime
  heures       Float      @default(0)
  cout         Float      @default(0)
  createdAt    DateTime   @default(now())

  @@index([entrepriseId, date])
  @@index([salarieId]) // ajouté pour accélérer les recherches
}

// Demande d'inscription ou de contact envoyée depuis la démo / la page de connexion
// statut : NOUVELLE → VALIDEE (entreprise + compte créés) ou REFUSEE
model DemandeInscription {
  id           String    @id @default(cuid())
  societe      String
  prenom       String
  nom          String
  email        String
  telephone    String?
  effectif     String?
  besoins      String[]
  message      String?
  type         String    @default("INSCRIPTION") // INSCRIPTION | CONTACT
  codeParrainage String?  // code de parrainage saisi par le prospect (rattaché à la validation)
  statut       String    @default("NOUVELLE")
  entrepriseId String?
  createdAt    DateTime  @default(now())
  traiteeAt    DateTime?

  @@index([statut])
}


// Établissement de l'entreprise (au moins un, avec adresse ; ajout gratuit)
model Etablissement {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  rue          String?
  codePostal   String?
  ville        String?
  siret        String?
  // Badge : zone de pointage (centre + rayon en mètres)
  latitude     Float?
  longitude    Float?
  rayon        Int        @default(200)
  createdAt    DateTime   @default(now())
  // Accès « dirigeant d'établissement » : ne voient que cet établissement et ses projets
  utilisateurs Utilisateur[]
  projets      Projet[]

  @@index([entrepriseId])
}

// Service de l'entreprise (onglet Services / organigramme)
model Service {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  ordre        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([entrepriseId, nom])
}

// Note de frais déclarée par un salarié (montant + motif, sans justificatif stocké)
// statut : En attente -> Validé / Refusé
model NoteFrais {
  id           String     @id @default(cuid())
  salarieId    String
  salarie      Salarie    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  date         DateTime
  montant      Float
  motif        String
  statut       String     @default("En attente")
  motifRefus   String?
  traitePar    String?
  variableId   String?
  projetId     String?    // projet sur lequel la dépense est refacturée / imputée
  projet       Projet?    @relation(fields: [projetId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([entrepriseId, statut])
  @@index([salarieId]) // ajouté pour accélérer les recherches
  @@index([projetId]) // ajouté pour accélérer les recherches
}

// Question d'un salarié à son N+1 (peut être reroutée au N+1 du manager ou à FRANEO RH)
// statut : OUVERTE -> REPONDUE -> CLOSE ; destinataire : FRANEO si rerouté chez FRANEO RH
model QuestionInterne {
  id             String     @id @default(cuid())
  entrepriseId   String
  entreprise     Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  auteurId       String
  destinataireId String?
  versFraneo     Boolean    @default(false)
  sujet          String
  statut         String     @default("OUVERTE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  messages       MessageInterne[]

  @@index([entrepriseId])
}

model MessageInterne {
  id         String          @id @default(cuid())
  questionId String
  question   QuestionInterne @relation(fields: [questionId], references: [id], onDelete: Cascade)
  auteur     String
  contenu    String
  createdAt  DateTime        @default(now())
}

// Demandes du client : accès à une autre app Franeo, audit RH, formation, autre besoin
// type : APP | AUDIT | FORMATION | AUTRE ; statut : EN_ATTENTE -> EN_COURS -> TRAITEE / REFUSEE
model DemandeService {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  type         String
  app          String?
  options      String[]
  message      String?
  remise       Float      @default(0)
  auteur       String?
  statut       String     @default("EN_ATTENTE")
  reponse      String?
  createdAt    DateTime   @default(now())
  traiteeAt    DateTime?
  messages       MessageDemandeService[]
  piecesJointes  PieceJointe[]
  // Demande validée : montant ajouté à la facture du mois choisi (ligne de prestation)
  commandeId     String?
  montantFacture Float?
  factureMois    Int?
  factureAnnee   Int?

  @@index([entrepriseId, statut])
}

// Échange écrit entre le client et FRANEO RH sur une demande complémentaire
model MessageDemandeService {
  id        String         @id @default(cuid())
  demandeId String
  demande   DemandeService @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  role      String         // ADMIN | CLIENT
  auteur    String
  contenu   String
  createdAt DateTime       @default(now())

  @@index([demandeId])
}

// Journal des saisies et modifications de paie (date et heure)
model JournalPaie {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  auteur       String
  action       String
  detail       String
  createdAt    DateTime   @default(now())

  @@index([entrepriseId, createdAt])
}

// Clôture du mois demandée par le client ; statut : DEMANDE_CLOTURE | CLOTURE | DEMANDE_DECLOTURE
model ClotureMois {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  mois         Int
  annee        Int
  statut       String
  auteur       String?
  updatedAt    DateTime   @updatedAt

  @@unique([entrepriseId, annee, mois])
}


// Pièce jointe d'une demande RH ponctuelle (conseil RH) — fichier stocké dans la base (4 Mo max)
model PieceJointe {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  // Une pièce jointe appartient à une demande RH, un devis ou une demande complémentaire
  questionId   String?
  question     QuestionRH? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  devisId          String?
  devis            Devis?          @relation(fields: [devisId], references: [id], onDelete: Cascade)
  demandeServiceId String?
  demandeService   DemandeService? @relation(fields: [demandeServiceId], references: [id], onDelete: Cascade)
  accidentId       String?
  accident         AccidentTravail? @relation(fields: [accidentId], references: [id], onDelete: Cascade)
  nom          String
  mime         String
  taille       Int
  contenu      Bytes?
  cle          String?
  auteur       String
  role         String
  createdAt    DateTime   @default(now())

  @@index([questionId])
  @@index([devisId])
  @@index([demandeServiceId])
  @@index([accidentId])
  @@index([entrepriseId]) // ajouté pour accélérer les recherches
}

// Modèle de contrat Word (.docx) déposé par le client, avec ses champs {{...}}
// Modèle de contrat Word : celui d'un client, ou (entrepriseId vide) un modèle FRANEO RH proposé à tous les clients
model TrameContrat {
  id           String      @id @default(cuid())
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  champs       String[]
  fichier      Bytes?
  cle          String?
  taille       Int
  createdAt    DateTime   @default(now())

  @@index([entrepriseId])
}

// Contrat généré par le client depuis un modèle (historique, consultable par FRANEO RH)
model DemandeContrat {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  salarieId    String?
  trameNom     String?
  typeContrat  String
  intitule     String
  donnees      Json
  auteur       String
  verification Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([entrepriseId, createdAt])
  @@index([salarieId]) // ajouté pour accélérer les recherches
}


// Badge : un pointage (arrivée, pause, reprise, départ) avec l'adresse où il a été fait (position au moment du clic)
model Pointage {
  id            String     @id @default(cuid())
  salarieId     String
  salarie       Salarie    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  type          String     // ARRIVEE | PAUSE | REPRISE | DEPART
  at            DateTime   @default(now())
  jour          String     // AAAA-MM-JJ (heure de Paris)
  dansZone      Boolean?
  etablissement String?
  adresse       String?
  projetId      String?    // projet choisi au pointage (option Projets)
  projet        Projet?    @relation(fields: [projetId], references: [id], onDelete: SetNull)
  motif         String?    // « position non partagée », « salarié itinérant »…
  commentaire   String?

  @@index([entrepriseId, jour])
  @@index([salarieId, jour])
  @@index([projetId]) // ajouté pour accélérer les recherches
}

// Questions auxquelles Buddy n'a pas su répondre, et réponses rédigées par l'admin (Communication › Questions Buddy)
// statut : A_TRAITER -> REPONDUE (Buddy réutilise la réponse) ou IGNOREE
model BuddyQuestion {
  id           String   @id @default(cuid())
  question     String
  normalisee   String   @unique
  motsCles     String[]
  reponse      String?
  // Réponse « chercher dans l'app » : Buddy va lire l'information demandée (absences, congés, échéances…)
  source       String?
  // Question reliée à une action que Buddy sait déjà faire (lib/buddy/catalogue.ts) : il l'exécute avec la phrase posée
  action       String?
  statut       String   @default("A_TRAITER")
  occurrences  Int      @default(1)
  entreprises  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([statut])
}

// ───────── Option « Projets, planning & rentabilité » (en cours de développement) ─────────
// statut : PREVU | EN_COURS | TERMINE | ANNULE ; modeVente : FORFAIT | REGIE (taux journalier × jours vendus) | INTERNE
model Projet {
  id              String     @id @default(cuid())
  entrepriseId    String
  entreprise      Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom             String
  code            String?
  client          String?
  description     String?
  couleur         String     @default("#ea580c")
  statut          String     @default("PREVU")
  dateDebut       DateTime
  dateFin         DateTime?
  modeVente       String     @default("FORFAIT")
  prixVente       Float?
  tauxJournalier  Float?
  joursVendus     Float?
  budgetHeures    Float?     // enveloppe d'heures (facultative)
  adresse         String?    // lieu d'intervention (chantier, site client…), affiché dans le planning du salarié
  modele          String?    // modèle métier choisi à la création (BTP, CONSEIL…)
  montantMensuel  Float?     // contrat récurrent : montant HT facturé chaque mois
  seuilAlerte     Int        @default(80) // % du budget consommé qui déclenche l'alerte
  responsableId   String?
  responsable     Salarie?   @relation("ResponsableProjet", fields: [responsableId], references: [id], onDelete: SetNull)
  // Établissement du projet (facultatif) : visible par le dirigeant de cet établissement
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  affectations    AffectationProjet[]
  depenses        DepenseProjet[]
  temps           TempsProjet[]
  pointages       Pointage[]
  notesFrais      NoteFrais[]
  jalons          JalonProjet[]
  devis           DevisProjet[]
  factures        FactureProjet[]

  @@index([entrepriseId, statut])
}

// Planning : un salarié affecté à un projet sur une période, X heures par semaine
model AffectationProjet {
  id            String   @id @default(cuid())
  projetId      String
  projet        Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  salarieId     String
  salarie       Salarie  @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  du            DateTime
  au            DateTime
  heuresSemaine Float
  role          String?
  createdAt     DateTime @default(now())

  @@index([salarieId, du])
  @@index([projetId])
}

// Frais du projet : prévus (budget) ou réels (dépensés) ; categorie : DEPLACEMENT | MATERIEL | SOUS_TRAITANCE | AUTRE
model DepenseProjet {
  id        String   @id @default(cuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  libelle   String
  categorie String   @default("AUTRE")
  montant   Float
  date      DateTime
  prevu     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projetId])
}

// Temps passé saisi à la main (en plus des heures pointées avec le projet)
model TempsProjet {
  id          String   @id @default(cuid())
  projetId    String
  projet      Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  salarieId   String
  salarie     Salarie  @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  jour        String   // AAAA-MM-JJ
  heures      Float
  commentaire String?
  releveId    String?  // renseigné : temps issu du relevé mensuel du salarié (recalculé à chaque enregistrement)
  createdAt   DateTime @default(now())

  @@index([projetId])
  @@index([salarieId, jour])
  @@index([releveId])
}

// Jalons du projet et échéancier de facturation
// etat : A_FAIRE | FAIT ; facturation : AUCUNE (jalon simple) | A_FACTURER | FACTURE | PAYE
model JalonProjet {
  id          String    @id @default(cuid())
  projetId    String
  projet      Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  libelle     String
  date        DateTime
  etat        String    @default("A_FAIRE")
  montant     Float?
  facturation String    @default("AUCUNE")
  faitLe      DateTime?
  createdAt   DateTime  @default(now())

  @@index([projetId, date])
}

// Devis chiffré depuis les coûts réels ; accepté, il crée le projet (ou s'ajoute au projet comme travaux supplémentaires)
// statut : BROUILLON | ENVOYE | ACCEPTE | REFUSE ; lignes : [{ libelle, type, quantite, unite, prixUnitaire, coutUnitaire, salarieId? }]
model DevisProjet {
  id            String     @id @default(cuid())
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  projetId      String?    // renseigné : avenant / travaux supplémentaires sur ce projet (ou projet créé à l'acceptation)
  projet        Projet?    @relation(fields: [projetId], references: [id], onDelete: SetNull)
  numero        String
  objet         String
  client        String?
  clientAdresse String?
  clientEmail   String?
  supplementaire Boolean   @default(false)
  modele        String?
  lignes        Json
  margeVisee    Float      @default(30)
  tauxTva       Float      @default(20)
  acomptePct    Float?
  validiteJours Int        @default(30)
  conditions    String?
  statut        String     @default("BROUILLON")
  dateDebut     DateTime?
  dateFin       DateTime?
  totalHT       Float      @default(0)
  coutTotal     Float      @default(0)
  envoyeLe      DateTime?
  accepteLe     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([entrepriseId, numero])
  @@index([entrepriseId, statut])
  @@index([projetId]) // ajouté pour accélérer les recherches
}

// Factures émises depuis un projet ; type : ACOMPTE | SITUATION | REGIE | SOLDE | JALON | MENSUELLE | AVOIR
// statut : EMISE | PAYEE | ANNULEE
model FactureProjet {
  id            String     @id @default(cuid())
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  projetId      String
  projet        Projet     @relation(fields: [projetId], references: [id], onDelete: Cascade)
  jalonId       String?
  numero        String
  type          String
  date          DateTime   @default(now())
  echeance      DateTime
  lignes        Json
  totalHT       Float
  tauxTva       Float      @default(20)
  totalTTC      Float
  periodeDu     String?    // régie / mensuelle : AAAA-MM-JJ
  periodeAu     String?
  statut        String     @default("EMISE")
  payeeLe       DateTime?
  relances      Int        @default(0)
  derniereRelance DateTime?
  note          String?
  createdAt     DateTime   @default(now())

  @@unique([entrepriseId, numero])
  @@index([projetId])
  @@index([entrepriseId, statut])
}

// Logo du client (image PNG en data URL, redimensionnée à l'envoi) : barre du haut et fichiers Excel.
// Dans une table à part pour ne pas alourdir la lecture de l'entreprise à chaque page.
model LogoEntreprise {
  entrepriseId String     @id
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  data         String
  largeur      Int
  hauteur      Int
  updatedAt    DateTime   @updatedAt
}

// ───────── Sécurité & RGPD ─────────
// Compteur de tentatives (connexion, mot de passe oublié) partagé entre tous les serveurs : anti-force brute
model TentativeConnexion {
  cle       String   @id // ex. « login:email:x@y.fr », « login:ip:1.2.3.4 », « reset:email:… »
  essais    Int      @default(0)
  debut     DateTime @default(now())
  bloqueJusqua DateTime?
}

// Journal d'audit : connexions, exports, suppressions, changements de droits, actions RGPD (conservé 1 an)
model JournalAudit {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  action        String   // LOGIN, LOGIN_ECHEC, LOGIN_BLOQUE, EXPORT, MDP_CHANGE, MDP_RESET, DROITS, SALARIE_SUPPR, RGPD_EXPORT, RGPD_ANONYMISATION…
  utilisateurId String?
  email         String?
  role          String?
  entrepriseId  String?
  cible         String?  // ex. « Salarié Sophie Martin », « Export salariés »
  details       String?
  ip            String?

  @@index([createdAt])
  @@index([entrepriseId, createdAt])
  @@index([action, createdAt])
}

// Textes des formules affichés aux clients, modifiés par l'admin (✏️ dans Abonnements).
// Prioritaires sur la grille par défaut (lib/grille.ts) et jamais écrasés par les mises à jour.
// cle : "rh:<nom de la formule>", "paie:<code>" ou "mention"
model TexteFormule {
  cle       String   @id
  message   String?
  lignes    String[] @default([])
  updatedAt DateTime @updatedAt
}


// ───────── Modèles de courriers et e-mails (rupture / prolongation de période d'essai, relances, attestations…) ─────────
// entrepriseId vide = modèle FRANEO RH proposé à tous les clients ; sinon modèle propre au client.
// Le contenu contient des champs {{salarie.prenom}}, {{entreprise.nom}}… ou {{Texte libre à compléter}}.
model ModeleCourrier {
  id           String      @id @default(cuid())
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  categorie    String      @default("Mes modèles")
  format       String      @default("COURRIER") // COURRIER | MAIL
  objet        String?
  contenu      String
  auteur       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([entrepriseId])
}

// ───────── Accidents du travail / de trajet ─────────
// Déclaré par le salarié (espace salarié) ou par l'employeur. L'employeur complète les informations
// de la déclaration (DAT, sous 48 h) puis les réponses au questionnaire de la CPAM.
// statut : A_DECLARER | DECLARE | INSTRUCTION | DECIDE | CLOS
model AccidentTravail {
  id               String     @id @default(cuid())
  entrepriseId     String
  entreprise       Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  salarieId        String
  salarie          Salarie    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  declarePar       String     @default("SALARIE") // SALARIE | EMPLOYEUR
  auteur           String?
  statut           String     @default("A_DECLARER")
  type             String     @default("TRAVAIL")  // TRAVAIL | TRAJET
  // L'accident (décrit par le salarié)
  dateAccident     DateTime
  heure            String?
  lieu             String?
  activite         String?
  circonstances    String?
  siegeLesions     String?
  natureLesions    String?
  temoins          String?
  premierePersonne String?
  soins            String?    // a consulté un médecin, hôpital…
  arret            Boolean    @default(false)
  tiers            String?
  // Employeur (déclaration d'accident du travail)
  connuLe          DateTime?
  horaires         String?
  constate         String?    // CONSTATE (par l'employeur) | DECRIT (par la victime)
  registreBenins   Boolean    @default(false)
  datDate          DateTime?
  datReference     String?
  reserves         String?
  // Instruction CPAM
  questionnaireRecuLe DateTime?
  questionnaire    Json?      // réponses aux questions de la CPAM { cle: réponse }
  questionnaireEnvoyeLe DateTime?
  decision         String?    // PRISE_EN_CHARGE | REFUS
  decisionLe       DateTime?
  repriseLe        DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  piecesJointes    PieceJointe[]

  @@index([entrepriseId, statut])
  @@index([salarieId])
}


// Double authentification : code à 6 chiffres envoyé par e-mail à la connexion (seule son empreinte est gardée)
model CodeConnexion {
  id            String   @id @default(cuid())
  utilisateurId String
  empreinte     String
  expiresAt     DateTime
  essais        Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([utilisateurId])
}

// Cabinet comptable partenaire : un seul accès pour tous ses clients, avec ses collaborateurs.
// Tarif sur mesure, paramétré par FRANEO RH.
model Cabinet {
  id             String        @id @default(cuid())
  nom            String
  siret          String?
  email          String?
  telephone      String?
  ville          String?
  actif          Boolean       @default(true)
  demo           Boolean       @default(false)
  // Tarif sur mesure (€/mois) : forfait + prix par dossier client (les clients du cabinet n'ont pas de formule)
  tarifForfait   Float?
  tarifParClient Float?
  tarifNote      String?
  createdAt      DateTime      @default(now())

  entreprises    Entreprise[]
  utilisateurs   Utilisateur[]
}

// Réglages de l'application (une seule ligne, id « global ») : maintenance annoncée et blocage pendant les mises à jour
model ReglageApp {
  id                 String    @id @default("global")
  // Parrainage : récompense appliquée automatiquement quand un filleul est rattaché (AUCUNE par défaut)
  parrainageType     String    @default("AUCUNE") // AUCUNE, POURCENT, MONTANT
  parrainageValeur   Float     @default(0)
  parrainageMois     Int       @default(1)        // durée de la remise, en mois
  parrainagePour     String    @default("PARRAIN") // PARRAIN, FILLEUL, LES_DEUX
  // Commission reversée au parrain : % du CA du filleul, pendant N mois (0 = aucune, vide = sans fin)
  parrainageCommissionPct  Float @default(0)
  parrainageCommissionMois Int?
  // Marges (pilotage) : coûts directs de production et cotisations / charges, en % du CA après remises
  margeCoutsDirectsPct Float @default(0)
  margeChargesPct      Float @default(0)
  maintenanceActive  Boolean   @default(false)   // l'application est bloquée (sauf pour l'admin)
  maintenanceMessage String?
  maintenanceDebut   DateTime?                   // maintenance programmée : annonce avant, blocage à partir de cette date
  maintenanceFin     DateTime?                   // fin prévue (affichée)
  // Démo : remise à zéro automatique chaque nuit (désactivable depuis le portail pour garder des modifications)
  demoResetAuto      Boolean   @default(true)
  demoDernierReset   DateTime?
  updatedAt          DateTime  @updatedAt
}

// Remise appliquée sur les factures d'une entreprise pendant une période (geste commercial, parrainage…).
// La remise permanente en % reste le champ Entreprise.remisePct.
model Remise {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  libelle      String
  motif        String     @default("COMMERCIALE") // COMMERCIALE, PARRAINAGE, FILLEUL
  type         String     @default("POURCENT")    // POURCENT, MONTANT (€ par mois)
  valeur       Float
  portee       String     @default("ABONNEMENTS") // ABONNEMENTS (abonnements, options, salariés et bulletins) ou TOUT
  moisDebut    Int
  anneeDebut   Int
  nbMois       Int?       // durée en mois ; vide = sans fin
  creePar      String?
  createdAt    DateTime   @default(now())

  @@index([entrepriseId])
}
// Bulletin de paie déposé par FRANEO RH, visible par le salarié (espace salarié) et par l'employeur
model Bulletin {
  id           String    @id @default(cuid())
  salarieId    String
  salarie      Salarie   @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  mois         Int
  annee        Int
  nom          String
  contenu      Bytes?
  cle          String?
  taille       Int
  vuLe         DateTime?
  createdAt    DateTime  @default(now())

  @@unique([salarieId, annee, mois])
  @@index([entrepriseId, annee, mois])
}

// Checklist d'arrivée ou de départ d'un salarié (DPAE, mutuelle, solde de tout compte…)
model ChecklistSalarie {
  id           String    @id @default(cuid())
  salarieId    String
  salarie      Salarie   @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  type         String    // ARRIVEE | DEPART
  faits        String[]  @default([])   // clés des étapes cochées
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@unique([salarieId, type])
  @@index([entrepriseId])
}

// Entretien annuel ou professionnel (tous les 2 ans, état des lieux à 6 ans)
model Entretien {
  id           String    @id @default(cuid())
  salarieId    String
  salarie      Salarie   @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  type         String    // ANNUEL | PROFESSIONNEL | ETAT_DES_LIEUX
  date         DateTime
  statut       String    @default("PLANIFIE") // PLANIFIE | REALISE
  responsable  String?
  compteRendu  Json?
  // Rubriques de la trame au moment de la saisie [{ cle, label }] (le compte rendu reste lisible si la trame change)
  rubriques    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([entrepriseId, date])
  @@index([salarieId])
}

// Modèles d'e-mails de FRANEO RH (bienvenue, relance, fin d'essai…), envoyés depuis la fiche d'un client
model ModeleEmail {
  id        String   @id @default(cuid())
  nom       String
  sujet     String
  corps     String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Trame d'entretien (annuel, professionnel, bilan 6 ans) : modèle FRANEO (entrepriseId vide) ou personnalisé par un client
model TrameEntretien {
  id           String   @id @default(cuid())
  entrepriseId String?
  type         String   // ANNUEL | PROFESSIONNEL | ETAT_DES_LIEUX
  rubriques    Json     // [{ cle, label }]
  updatedAt    DateTime @updatedAt

  @@unique([entrepriseId, type])
}

// Code promo saisi à l'inscription ou rattaché par l'admin (ex. TARTENPION = 10 % pendant 3 mois)
model CodePromo {
  id              String    @id @default(cuid())
  code            String    @unique
  type            String    @default("POURCENT") // POURCENT | MONTANT (€ par mois)
  valeur          Float
  portee          String    @default("ABONNEMENTS") // ABONNEMENTS | TOUT
  nbMois          Int?      // vide = sans fin
  actif           Boolean   @default(true)
  finValidite     DateTime? // après cette date, le code n'est plus accepté
  maxUtilisations Int?
  utilisations    Int       @default(0)
  // Commission à reverser au bénéficiaire du code (partenaire, apporteur) : % du CA du client, pendant N mois
  commissionPct   Float?
  commissionMois  Int?
  beneficiaire    String?
  note            String?
  createdAt       DateTime  @default(now())
}

// Commission reversée pour un mois (trace de paiement à l'apporteur / au parrain)
model CommissionVersee {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  mois         Int
  annee        Int
  base         Float      // CA retenu
  pct          Float
  montant      Float
  beneficiaire String?
  verseLe      DateTime   @default(now())
  par          String?

  @@unique([entrepriseId, mois, annee])
}

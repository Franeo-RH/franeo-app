generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Abonnement {
  id                String       @id @default(cuid())
  nom               String
  prixMensuel       Float
  ticketsRH         Int          @default(0)
  prixTicketSupp    Float        @default(0)
  salariesInclus    Int          @default(0)
  prixSalarieSupp   Float        @default(0)
  features          String[]
  createdAt         DateTime     @default(now())

  entreprises       Entreprise[]
}

model Entreprise {
  id                String             @id @default(cuid())
  nom               String
  siret             String?
  telephone         String?
  email             String?
  siteWeb           String?

  rue               String?
  codePostal        String?
  ville             String?
  pays              String?

  iban              String?
  bic               String?
  banque            String?

  abonnementId      String?
  demo              Boolean            @default(false)
  tauxCharges       Float              @default(40) // % de charges patronales (estimation)
  actif             Boolean            @default(true)
  motifSuspension   String?
  dateSuspension    DateTime?
  abonnement        Abonnement?        @relation(fields: [abonnementId], references: [id])
  ticketsUtilises   Int                @default(0)

  permissions       String[]           @default(["salaries", "paie", "tickets", "absences", "entreprise", "helpdesk"])
  // Indicateurs RH : budgets annuels (facultatifs)
  budgetPrimesAnnuel    Float?
  budgetFormationAnnuel Float?

  createdAt         DateTime           @default(now())

  utilisateurs      Utilisateur[]
  salaries          Salarie[]
  demandesEvolution DemandeEvolution[]
  tickets           Ticket[]
  variablesPaie     VariablePaie[]
  absences          Absence[]
  ticketsSupport    TicketSupport[]
  facturations      Facturation[]
  recrutements      DemandeRecrutement[]
  abonnementPaieId  String?
  abonnementPaie    AbonnementPaie? @relation(fields: [abonnementPaieId], references: [id])
  bulletinsUtilises Int             @default(0)
  demandesEvolutionPaie DemandeEvolutionPaie[]
  demandesSalaries  DemandeSalarie[]
  prestations       CommandePrestation[]
  faqs              FAQ[]
  communications    Communication[]
  releves           ReleveMois[]
  devis             Devis[]
  questionsRH       QuestionRH[]
  formations        Formation[]
}

model Facturation {
  id              String      @id @default(cuid())
  mois            Int
  annee           Int
  montant         Float
  dateLimitePaie  DateTime?
  statut          String      @default("En attente")
  commentaire     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  entrepriseId    String
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, annee, mois])
  @@index([annee, mois])
}

model DemandeRecrutement {
  id                String     @id @default(cuid())
  statut            String     @default("Reçue")
  poste             String
  typeContrat       String
  dateDebut         DateTime?
  salaireMini       Float?
  salaireMaxi       Float?
  primes            String?
  missions          String
  profil            String
  experience        String?
  formation         String?
  commentaire       String?
  cgvAcceptees      Boolean    @default(false)
  // Grille : NON_QUALIFIE, TECHNICIEN ou EXPERT (lancement 400 € + primes à la signature et à la fin d'essai)
  categorie         String     @default("NON_QUALIFIE")
  // true : lancement et primes calculés dans la facture du mois (les anciennes demandes ont été facturées à part)
  facturationAuto   Boolean    @default(false)
  candidat          String?
  signatureAt       DateTime?
  finEssaiAt        DateTime?
  termineAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  entrepriseId      String
  entreprise        Entreprise @relation(fields: [entrepriseId], references: [id])
}

model DemandeEvolution {
  id              String      @id @default(cuid())
  statut          String      @default("En attente")
  message         String?
  createdAt       DateTime    @default(now())

  entrepriseId    String
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  abonnementId    String
}

model Utilisateur {
  id           String      @id @default(cuid())
  email        String      @unique
  motDePasse   String
  prenom       String
  role         Role        @default(CLIENT)
  createdAt    DateTime    @default(now())

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  // Espace salarié : compte relié à une fiche salarié
  salarieId    String?     @unique
  salarie      Salarie?    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  actif        Boolean     @default(true)
  lectures     LectureCommunication[]

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId])
}

model TokenReset {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  // vide = visible par tous les clients ; sinon réservée à une seule entreprise
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  module    String
  question  String
  reponse   String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salarie {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  statut                String         @default("Actif")

  entrepriseId          String
  entreprise            Entreprise     @relation(fields: [entrepriseId], references: [id])

  nom                   String
  prenom                String
  email                 String?
  telephone             String?
  dateNaissance         DateTime?
  lieuNaissance         String?
  nationalite           String?
  numeroSecuriteSociale String?

  rue                   String?
  codePostal            String?
  ville                 String?
  pays                  String?

  poste                 String
  typeContrat           String?
  dateDebut             DateTime?
  dateFin               DateTime?
  heuresHebdomadaires   Float?
  manager               String?
  conventionCollective  String?
  categorie             String?
  coefficient           String?

  salaireMensuel        Float?
  salaireAnnuel         Float?
  primes                Float?
  avantages             String?

  titreSejour           DateTime?
  matricule             String?
  // Indicateurs RH
  etablissement         String?
  service               String?
  soldeConges           Float?
  formations            Formation[]
  rappels               RappelSalarie[]
  compte                Utilisateur?

  documents             Document[]
  variablesPaie         VariablePaie[]
  absences              Absence[]
  releves               ReleveMois[]

  @@unique([entrepriseId, matricule])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model Document {
  id          String   @id @default(cuid())
  nom         String
  type        String
  url         String
  dateAjout   DateTime @default(now())

  salarieId   String
  salarie     Salarie  @relation(fields: [salarieId], references: [id], onDelete: Cascade)
}

model Ticket {
  id           String          @id @default(cuid())
  titre        String
  description  String
  statut       String          @default("Ouvert")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  entrepriseId String
  entreprise   Entreprise      @relation(fields: [entrepriseId], references: [id])

  messages     MessageTicket[]

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model MessageTicket {
  id        String   @id @default(cuid())
  contenu   String
  auteur    String
  role      Role
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // index ajouté pour accélérer les recherches
  @@index([ticketId])
}

model TicketSupport {
  id           String                @id @default(cuid())
  titre        String
  description  String
  categorie    CategorieSupport
  statut       String                @default("Ouvert")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  entrepriseId String
  entreprise   Entreprise            @relation(fields: [entrepriseId], references: [id])

  messages     MessageTicketSupport[]

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
}

model MessageTicketSupport {
  id        String        @id @default(cuid())
  contenu   String
  auteur    String
  role      Role
  createdAt DateTime      @default(now())

  ticketId  String
  ticket    TicketSupport @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // index ajouté pour accélérer les recherches
  @@index([ticketId])
}

model VariablePaie {
  id             String       @id @default(cuid())
  type           TypeVariable
  valeur         Float
  commentaire    String?
  mois           Int
  annee          Int
  statut         String       @default("En attente")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dateValidation DateTime?
  dateReset      DateTime?

  salarieId      String
  salarie        Salarie      @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  entrepriseId   String
  entreprise     Entreprise   @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, annee, mois])
  @@index([annee, mois, statut])
  @@index([salarieId])
}

model Absence {
  id           String      @id @default(cuid())
  type         TypeAbsence
  dateDebut    DateTime
  dateFin      DateTime
  commentaire  String?
  statut       String      @default("En attente")
  declareeParSalarie Boolean @default(false) // saisie depuis l'espace salarié
  motifRefus   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  salarieId    String
  salarie      Salarie     @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  entrepriseId String
  entreprise   Entreprise  @relation(fields: [entrepriseId], references: [id])

  // index ajouté pour accélérer les recherches
  @@index([entrepriseId, statut])
  @@index([salarieId])
}

enum TypeVariable {
  HEURE_SUPPLEMENTAIRE
  PRIME
  NOTE_FRAIS
  ACOMPTE
}

enum TypeAbsence {
  CONGE_PAYE
  RTT
  CONGE_SANS_SOLDE
  CONGE_EXCEPTIONNEL
  CONGE_NAISSANCE
  MATERNITE_PATERNITE
  MALADIE
  ABSENCE_NON_REMUNEREE
}

enum CategorieSupport {
  BUG
  QUESTION
  SUGGESTION
  PROBLEME_TECHNIQUE
}

enum Role {
  ADMIN
  CLIENT
  SALARIE
}

model AbonnementPaie {
  id                    String     @id @default(cuid())
  code                  String     @unique // "ESSENTIELLE" | "SERENITE" | "PREMIUM"
  nom                   String
  couleur               String     @default("#6366f1")
  prixMensuel           Float
  bulletinsInclus       Int
  prixBulletinSupp      Float
  // Features booléennes
  relancesVariables     Boolean    @default(false)
  relancesSalaries      Boolean    @default(false)
  modificationsIncluses Boolean    @default(false)
  regularisationsInclus Boolean    @default(false)
  demandesComplexes     Boolean    @default(false)
  veillePaie            Boolean    @default(false)
  conseilPaie           Boolean    @default(false)
  suiviRH               Boolean    @default(false) // périodes essai, CDD, absences, maladie, visites médicales
  suiviIJSS             Boolean    @default(false)
  relancesIJSS          Boolean    @default(false)
  recouvrementIJSS      Boolean    @default(false)
  tableauBord           String     @default("none") // "none" | "simple" | "complet"
  pointPaie             Boolean    @default(false)
  recommandationsPaie   Boolean    @default(false)
  traitementPrioritaire Boolean    @default(false)
  assistanceURSSAF      Boolean    @default(false)
  accesWebApp           Boolean    @default(true)  // application Franeo (web + téléphone)
  entreesSortiesIncluses Boolean   @default(false) // arrivées et soldes de tout compte inclus
  prixEntree            Float      @default(45)    // si non inclus : prix d'une arrivée
  prixSortie            Float      @default(60)    // si non inclus : prix d'une sortie (STC)
  ticketsRHInclus       Int        @default(0)     // tickets RH offerts chaque mois avec la formule paie
  prixTicketSupp        Float      @default(0)     // prix d'un ticket RH au-delà des tickets inclus
  espaceSalarieInclus   Boolean    @default(false) // espace salarié inclus (Premium, Entreprise)
  prixEspaceSalarie     Float      @default(1)     // sinon : prix par salarié et par mois
  createdAt             DateTime   @default(now())
  entreprises           Entreprise[]
  demandesAncienne DemandeEvolutionPaie[] @relation("AncienneFormulePaie")
  demandesNouvelle DemandeEvolutionPaie[] @relation("NouvelleFormulePaie")
}

model DemandeEvolutionPaie {
  id            String    @id @default(cuid())
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id])
  ancienneFormuleId String?
  ancienneFormule   AbonnementPaie? @relation("AncienneFormulePaie", fields: [ancienneFormuleId], references: [id])
  nouvelleFormuleId String
  nouvelleFormule   AbonnementPaie  @relation("NouvelleFormulePaie", fields: [nouvelleFormuleId], references: [id])
  statut        String    @default("EN_ATTENTE")
  createdAt     DateTime  @default(now())
  traiteeAt     DateTime?
}

model Actualite {
  id          String   @id @default(cuid())
  titre       String
  contenu     String
  thematique  String   @default("Général")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuddyContexte {
  userId    String   @id
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

model RappelSalarie {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  type         String
  libelle      String?
  dateEcheance DateTime
  commentaire  String?
  traite       Boolean   @default(false)
  traiteAt     DateTime?

  salarieId    String
  salarie      Salarie   @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  @@index([dateEcheance])

  // index ajouté pour accélérer les recherches
  @@index([salarieId])
}
// Demande de validation d'un client « paie » : ajout, modification ou suppression d'un salarié
model DemandeSalarie {
  id           String     @id @default(cuid())
  type         String     // "AJOUT" | "MODIFICATION" | "SUPPRESSION"
  statut       String     @default("EN_ATTENTE") // "EN_ATTENTE" | "VALIDEE" | "REFUSEE"
  resume       String
  donnees      Json?
  motifRefus   String?
  auteur       String?
  createdAt    DateTime   @default(now())
  traiteAt     DateTime?

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  salarieId    String?

  @@index([entrepriseId, statut])
  @@index([statut])
}

// Prestation commandée par un client depuis l'application (facturée sur le mois de la commande)
model CommandePrestation {
  id           String     @id @default(cuid())
  code         String     // ex. "RECTIFICATIF", "RUPTURE_CONV"
  libelle      String
  quantite     Int        @default(1)
  prixUnitaire Float      // 0 = inclus dans la formule
  total        Float
  statut       String     @default("A_FAIRE") // "A_FAIRE" | "FAITE" | "ANNULEE"
  commentaire  String?
  salarie      String?    // nom du salarié concerné (texte, pour garder la trace)
  auteur       String?
  mois         Int
  annee        Int
  createdAt    DateTime   @default(now())
  faiteAt      DateTime?

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId, annee, mois])
  @@index([statut])
}


// Communication publiée par l'admin : affichée sur le tableau de bord jusqu'à ce que la personne clique « J'ai lu »
model Communication {
  id           String      @id @default(cuid())
  titre        String
  contenu      String
  // CLIENTS, SALARIES ou TOUS
  cible        String      @default("CLIENTS")
  // vide = toutes les entreprises
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  importante   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  lectures     LectureCommunication[]

  @@index([createdAt])
}

model LectureCommunication {
  id              String        @id @default(cuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  utilisateurId   String
  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luAt            DateTime      @default(now())

  @@unique([communicationId, utilisateurId])
}

// Relevé d'activité mensuel du salarié : brouillon enregistré au fil du mois, puis envoyé (verrouillé)
// statut : Brouillon → Envoyé → Validé (ou Refusé, qui le rouvre au salarié)
model ReleveMois {
  id           String         @id @default(cuid())
  salarieId    String
  salarie      Salarie        @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  entreprise   Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  mois         Int
  annee        Int
  statut       String         @default("Brouillon")
  motifRefus   String?
  envoyeAt     DateTime?
  valideAt     DateTime?
  // variable de paie « heures supplémentaires » créée à la validation
  variableId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  jours        ReleveJour[]

  @@unique([salarieId, annee, mois])
  @@index([entrepriseId, statut])
}

model ReleveJour {
  id          String     @id @default(cuid())
  releveId    String
  releve      ReleveMois @relation(fields: [releveId], references: [id], onDelete: Cascade)
  // jour (stocké à midi UTC)
  date        DateTime
  heures      Float?
  heuresSupp  Float      @default(0)
  teletravail Boolean    @default(false)
  commentaire String?

  @@unique([releveId, date])
}

// Demande de devis faite par le client depuis le catalogue (Mon entreprise › Demande de devis)
// statut : EN_ATTENTE → ENVOYE (proposition de l'admin) → ACCEPTE / REFUSE, ou ANNULE
model Devis {
  id             String     @id @default(cuid())
  entrepriseId   String
  entreprise     Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  lignes         Json
  totalIndicatif Float      @default(0)
  message        String?
  auteur         String?
  statut         String     @default("EN_ATTENTE")
  montantPropose Float?
  reponse        String?
  reponduAt      DateTime?
  decideAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  messages       MessageDevis[]

  @@index([entrepriseId, statut])
}

// Échange écrit entre le client et FRANEO RH sur un devis
model MessageDevis {
  id        String   @id @default(cuid())
  devisId   String
  devis     Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  role      String   // ADMIN | CLIENT
  auteur    String
  contenu   String
  createdAt DateTime @default(now())

  @@index([devisId])
}

// Demande RH ponctuelle : question simple, échange rapide, non décomptée des tickets
// statut : OUVERTE → REPONDUE (ou TICKET si l'admin demande d'ouvrir un ticket) → CLOSE
model QuestionRH {
  id           String            @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise        @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  sujet        String
  statut       String            @default("OUVERTE")
  auteur       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     MessageQuestionRH[]

  @@index([entrepriseId, statut])
}

model MessageQuestionRH {
  id         String     @id @default(cuid())
  questionId String
  question   QuestionRH @relation(fields: [questionId], references: [id], onDelete: Cascade)
  role       String     // ADMIN | CLIENT
  auteur     String
  contenu    String
  // réponse rapide « merci d'ouvrir un ticket » : affiche le lien vers un nouveau ticket
  versTicket Boolean    @default(false)
  createdAt  DateTime   @default(now())
}

// Formation suivie par un salarié (indicateurs RH : heures et budget)
model Formation {
  id           String     @id @default(cuid())
  salarieId    String
  salarie      Salarie    @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  intitule     String
  date         DateTime
  heures       Float      @default(0)
  cout         Float      @default(0)
  createdAt    DateTime   @default(now())

  @@index([entrepriseId, date])
}

// Demande d'inscription ou de contact envoyée depuis la démo / la page de connexion
// statut : NOUVELLE → VALIDEE (entreprise + compte créés) ou REFUSEE
model DemandeInscription {
  id           String    @id @default(cuid())
  societe      String
  prenom       String
  nom          String
  email        String
  telephone    String?
  effectif     String?
  besoins      String[]
  message      String?
  type         String    @default("INSCRIPTION") // INSCRIPTION | CONTACT
  statut       String    @default("NOUVELLE")
  entrepriseId String?
  createdAt    DateTime  @default(now())
  traiteeAt    DateTime?

  @@index([statut])
}
